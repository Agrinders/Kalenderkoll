<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="4dp" android:orientation="horizontal" android:background="@drawable/kk_item" android:padding="5dp">
    <TextView android:id="@+id/kk_ib" android:layout_width="3dp" android:layout_height="match_parent" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="6dp" android:orientation="vertical">
        <TextView android:id="@+id/kk_in" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="13sp" android:textStyle="bold" android:textColor="@color/kk_ink" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/kk_it" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="@color/kk_soft" android:maxLines="1" />
    </LinearLayout>
</LinearLayout>
